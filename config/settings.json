{
  "lastChangelogVersion": "1.0.4",
  "theme": "light/dark",
  "defaultProvider": "9router",
  "defaultModel": "ocg/deepseek-v4.1-flash",
  "defaultThinkingLevel": "high",
  "defaultProjectTrust": "always",
  "tuiMode": "fullscreen",
  "fullscreenScrollbar": "auto",
  "fullscreenExitOutput": "resume-hint",
  "packages": [
    "npm:pi-web-access",
    "npm:pi-subagents",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:pi-goal-x",
    "npm:pi-background-tasks",
    "npm:@narumitw/pi-usage",
    "npm:pi-simplify",
    {
      "source": "npm:pi-powerline-footer",
      "extensions": []
    },
    "npm:pi-memory",
    "npm:pi-worktree",
    "npm:pi-footer",
    "npm:pi-smart-fetch@0.3.17",
    "npm:@juicesharp/rpiv-btw",
    "npm:pi-model-fallback",
    "npm:pi-advisor-flow",
    "npm:@tmustier/pi-session-recap",
    "npm:pi-lens",
    "npm:@99percentpeople/pi-todo",
    "npm:@injaneity/pi-computer-use",
    "npm:pi-tool-display",
    "npm:pi-impeccable"
  ],
  "showCacheMissNotices": true,
  "thinkingBudgets": {
    "medium": 10240,
    "high": 32768
  },
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 20000,
    "modelOverrides": {
      "9router/ocg/deepseek-v4.1-flash": {
        "reserveTokens": 64000
      }
    }
  },
  "retry": {
    "enabled": true,
    "maxRetries": 3
  },
  "markdown": {
    "mermaid": "streaming"
  },
  "images": {
    "blockImages": true
  },
  "skills": [
    "!**/.agents/**"
  ],
  "hideThinkingBlock": true
}
