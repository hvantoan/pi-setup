# File/đường dẫn KHÔNG đưa vào repo public này.
# Mỗi dòng 1 glob, tính từ gốc thư mục config/. Dấu # bắt đầu comment.
# được scripts/pi-setup-backup.sh --config-dir tôn trọng khi mirror.

# 3 extension do Orca sinh (@orca-managed-pi-extension).
# Orca tự sinh lại khi quản lý pi trên máy mới, nên không mất chức năng.
extensions/orca-*.ts

# Extension mailbox do intec/orca cài (index.js + dist, code đã build kèm
# glue 127.0.0.1 hook). Cùng nhóm "công cụ khác tự cài lại" → loại khỏi repo.
extensions/intec-orca-mailbox*

# 2 thư mục do AgentKit (ak CLI) tự cài vào ~/.pi/agent/extensions/.
# Chứa cache path tuyệt đối (native-skill-paths.json 157 KB,
# native-skill-hashes.json 280 KB) + 1.2 MB hook đã sinh sẵn.
# AgentKit tự cài lại trên máy mới bằng `ak`, nên không thuộc repo này.
extensions/agentkit-*

# Hook do herdr sinh (~/.pi/agent/extensions/herdr-agent-state.ts).
# Header ghi rõ "managed by herdr; reinstalling or updating the integration
# overwrites this file" → herdr tự cài lại trên máy mới, bản trong repo sẽ lỗi thời.
extensions/herdr-*.ts

# State của pi-advisor-flow (salt + log outcome) — không phải setup, không public
advisor-outcomes.jsonl
advisor-outcomes-salt

# File backup tay nằm lẫn trong extensions/ (sinh ra khi sửa extension trực tiếp
# trên máy). Không phải setup, mirror bỏ qua nhờ dòng này.
extensions/*.bak*

# models.json: bản LIVE (rewrite 06/10) chứa apiKey 9router dạng literal, còn bản
# từng commit trước đây dùng "$NINEROUTER_API_KEY" (env) nên lịch sử git vẫn sạch.
# Loại khỏi snapshot để key literal không lọt vào repo; máy mới tự khai lại provider.
models.json

# mcp.json: MCP built-in của pi (pi >= 1.0). Cùng lý do như models.json — bản LIVE chứa
# token thật trong env (JIRA_API_TOKEN, JIRA_URL nội bộ công ty…) nên không lên repo
# public. Máy mới tự khai lại bằng `pi mcp add`, hoặc copy file riêng.
mcp.json
